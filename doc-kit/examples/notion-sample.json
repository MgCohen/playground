  {
   "title": "The circuit",
   "blocks": [
    {
     "type": "p",
     "text": "Each full adder adds three bits: **A**, **B** and the carry in. It gives one sum bit **S** and one carry out."
    },
    {
     "type": "list",
     "ordered": false,
     "items": [
      "Inputs: `A3..A0`, `B3..B0` and `Cin`",
      "Outputs: `S3..S0` and `Cout`",
      "Gates in each full adder: 2 XOR, 2 AND, 1 OR"
     ]
    },
