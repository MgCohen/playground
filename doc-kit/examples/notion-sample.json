    {
     "type": "callout",
     "text": "The result is correct only after the carry goes through all four stages.",
     "icon": "⚡"
    },
    {
     "type": "list",
     "ordered": true,
     "items": [
      "Make a half adder: one XOR and one AND.",
      "Make a full adder from two half adders and one OR.",
      "Connect four full adders in a chain.",
      "Test all 512 input cases."
     ]
    },
    {
     "type": "code",
     "lang": "",
     "code": "module full_adder(input a, b, cin, output s, cout);\n  wire p = a ^ b;\n  assign s    = p ^ cin;\n  assign cout = (a & b) | (p & cin);\nendmodule"
    }
   ]
