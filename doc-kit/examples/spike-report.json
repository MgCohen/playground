  {
   "title": "One clock tick",
   "blocks": [
    { "type": "stack", "data": {
      "groups": [
       { "title": "", "stacks": [
        { "root": [
         { "call": "posedge clk", "key": true, "note": "state = MAIN_GREEN, t = 20, car = 1", "children": [
          { "call": "next_state(state, t, car)", "key": true, "children": [
           { "call": "go = car AND (t ≥ 20)", "note": "go = 1" },
           { "call": "next = MAIN_YELLOW", "note": "state + 1" }
          ] },
          { "call": "state ← next", "note": "flip-flops load on the edge" },
          { "call": "t ← 0", "note": "clear, because go = 1" },
          { "call": "lamps(MAIN_YELLOW)", "children": [
           { "call": "main = Y", "note": "main road yellow" },
           { "call": "side = R", "note": "side road stays red" }
          ] }
         ] }
        ], "foot": "The lamps change one gate delay after the clock edge." }
       ] }
      ]
    } }
   ]
  },
  {
   "title": "State table",
   "blocks": [
    { "type": "table", "head": ["State", "Code", "Main", "Side", "Go to next when"], "rows": [
     ["MAIN_GREEN", "`00`", "G", "R", "car and t ≥ 20 s"],
     ["MAIN_YELLOW", "`01`", "Y", "R", "t ≥ 3 s"],
     ["SIDE_GREEN", "`10`", "R", "G", "t ≥ 10 s, or no car"],
     ["SIDE_YELLOW", "`11`", "R", "Y", "t ≥ 3 s"]
    ] },
    { "type": "code", "lang": "verilog", "code": "always @(posedge clk) begin\n  if (rst)        begin state <= `MAIN_GREEN; t <= 0; end\n  else if (go)    begin state <= state + 1;   t <= 0; end\n  else if (t < 31)      t <= t + 1;\nend" }
   ]
  },
  {
   "title": "Design notes",
   "blocks": [
    { "type": "folds", "data": { "items": [
     { "title": "Why binary order", "summary": "The codes count 00 → 01 → 10 → 11", "body": [
      { "type": "p", "text": "Each change is `state + 1`, so the next-state logic is one adder and one AND gate. A Gray code changes one bit each step, but needs a small table." }
     ] },
     { "title": "Safety", "summary": "The two roads never have green at the same time", "body": [
      { "type": "list", "items": ["Each state has red on at least one road", "A yellow state is always between two green states", "Reset goes to `MAIN_GREEN`, not to a random state"] }
     ] },
     { "title": "Variants", "summary": "Two changes that real crossings use", "children": [
      { "title": "Walk button", "summary": "A fifth state for people", "body": [
       { "type": "p", "text": "A `WALK` state between `MAIN_YELLOW` and `SIDE_GREEN`. All cars have red. It needs 3 state bits." }
      ] },
      { "title": "Night mode", "summary": "Yellow flashes on the main road", "body": [
       { "type": "p", "text": "A `night` input skips the cycle. The main yellow lamp is on when `t` is even." }
      ] }
     ] }
    ] } }
   ]
  }
