{
  "type": "object",
  "properties": {
    "action": { "type": "string", "enum": ["grade", "commit"] },
    "grade": {
      "type": "array",
      "description": "grade only: the sets to grade, each with its spec",
      "items": {
        "type": "object",
        "properties": {
          "spec": { "type": "string" },
          "set": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["spec", "set"]
      }
    },
    "assignment": {
      "type": "array",
      "description": "grade only, and only if the input has rubrics over all sets: one set (or null) for each spec, graded together",
      "items": {
        "type": "object",
        "properties": {
          "spec": { "type": "string" },
          "set": { "type": ["array", "null"], "items": { "type": "string" } }
        },
        "required": ["spec", "set"]
      }
    },
    "commit": {
      "type": "array",
      "description": "commit only: one item for each spec; set null means none",
      "items": {
        "type": "object",
        "properties": {
          "spec": { "type": "string" },
          "set": { "type": ["array", "null"], "items": { "type": "string" } },
          "reason": { "type": "string" },
          "gap": {
            "type": "object",
            "description": "only if the input has a Gaps section: a new entry for the remainder of this set",
            "properties": {
              "new_id": { "type": "string" },
              "nearest": { "type": "string" }
            },
            "required": ["new_id"]
          }
        },
        "required": ["spec", "set", "reason"]
      }
    },
    "note": { "type": "string" }
  },
  "required": ["action", "note"]
}
