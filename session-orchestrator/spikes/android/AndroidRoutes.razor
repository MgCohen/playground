@* The router of the Android host. Routes.razor of Orchestrator.Web names the server assembly, so the host has its own copy. *@
@using Microsoft.AspNetCore.Components.Routing
@using Orchestrator.Web.Components.Layout
<Router AppAssembly="typeof(AndroidRoutes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
    </Found>
</Router>
