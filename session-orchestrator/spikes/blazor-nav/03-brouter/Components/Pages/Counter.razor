@page "/counter"
@inherits TracedPage
@implements IBrouterRoute
@inject IBrouter Brouter
@inject CounterState State

<div class="page" data-test="page-counter">
    <h1>Counter <button data-test="back" @onclick="Back">Back</button></h1>
    <div class="count" data-test="count">@State.Count</div>
    <label>Note: <input data-test="note" @bind="note" /></label>
</div>

@code {
    string note = "";
    bool cancelledOnce;

    protected override string PageName => "Counter";

    void Back()
    {
        Trace.Add("Counter: Brouter.Back()");
        Brouter.Back();
    }

    // A kept page does not render again when it shows: render it, so the shared count is current (F4).
    public ValueTask OnActivatedAsync(BrouterRouteActivation a) { Trace.Add($"Counter: OnActivated (first={a.IsFirstActivation})"); StateHasChanged(); return default; }
    public ValueTask OnDeactivatedAsync(BrouterRouteDeactivation d) { Trace.Add($"Counter: OnDeactivated ({d.Reason})"); return default; }
    public ValueTask OnRenavigatingAsync(BrouterRouteRenavigatingContext c) { Trace.Add("Counter: OnRenavigating"); return default; }
    public ValueTask OnRenavigatedAsync(BrouterRouteRenavigation r) { Trace.Add("Counter: OnRenavigated"); return default; }

    // The leave lock: if note is "stay", cancel the first leave only.
    public ValueTask OnDeactivatingAsync(BrouterRouteDeactivatingContext c)
    {
        Trace.Add($"Counter: OnDeactivating ({c.Reason})");
        if (note == "stay" && !cancelledOnce)
        {
            cancelledOnce = true;
            Trace.Add("Counter: Cancel()");
            c.Cancel();
        }
        return default;
    }
}
