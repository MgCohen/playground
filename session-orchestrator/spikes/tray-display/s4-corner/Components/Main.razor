@* The content of the spike: simple shapes in the stage component. *@
<Dock Title="S4 corner window">
    @for (var i = 0; i < 6; i++)
    {
        var n = i;
        <div class="row">
            <Circle Size="@(28 + n * 4)" />
            <span>Row @(n + 1)</span>
        </div>
    }
    <FrameMeter />
</Dock>
