<Project Sdk="Microsoft.NET.Sdk">
  <!-- A screen recorder for the demo videos of the tray: pictures of one screen area with the pointer, written as a looping GIF.
       Not in the solution. Run: dotnet run with the arguments "x y width height scale fps seconds out.gif" -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
</Project>
