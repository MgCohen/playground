{
  "label": "Answer",
  "icon": "pen",
  "tone": "accent",
  "actions": [
    { "id": "approve", "label": "Approve", "role": "main" },
    { "id": "change", "label": "Request a change", "role": "other" },
    { "id": "diff", "label": "Open the diff", "role": "other" },
    { "id": "refuse", "label": "Refuse", "role": "danger" }
  ],
  "document": {
    "title": ["{{text}}"],
    "subtitle": ["{{question}}"],
    "facts": [
      { "field": "by", "label": "By", "as": "pill", "tones": { "user": "accent", "docs": "new", "policy": "pending" } },
      { "field": "onDefault", "label": "Then", "as": "code" }
    ],
    "blocks": [
      { "field": "reason", "label": "Reason" },
      { "field": "source", "label": "Source", "as": "well" }
    ]
  },
  "preview": {
    "title": ["{{text}}"],
    "line": ["{{question}}"],
    "well": [
      { "field": "reason", "label": "Reason" },
      { "field": "source", "label": "Source" }
    ],
    "pill": { "field": "by", "label": "By", "as": "pill", "tones": { "user": "accent", "docs": "new", "policy": "pending" } }
  }
}
