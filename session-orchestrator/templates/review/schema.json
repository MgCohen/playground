{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "description": "The verdict of the user on a default decision.",
  "type": "object",
  "required": ["decision", "verdict"],
  "properties": {
    "decision": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["approve", "change", "refuse"] },
    "text": { "type": "string", "description": "The direction of the user, in free text." }
  },
  "additionalProperties": false
}
