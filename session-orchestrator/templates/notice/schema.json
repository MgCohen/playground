{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notice",
  "description": "A fixed fact of the supervisor to a session. Each kind has its own file in render/.",
  "type": "object",
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "question-reminder",
        "question-closed",
        "archive-self",
        "restart"
      ]
    },
    "decision": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "child": {
      "type": "string"
    },
    "by": {
      "type": "string"
    },
    "waited": {
      "type": "string"
    },
    "count": {
      "type": "number"
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
