# The variables of the cloud environment of an orch cloud worker (G-4).
# Copy the names into the environment settings of the cloud environment. Recipe: docs/know-how.md, section "Cloud environment".
# Never write a secret in this file: the repository is not a secret store.

# The address of the supervisor on this PC, through the named tunnel of D2. orch uses the store API there (HTTP mode, H5).
# A VM team (supervisor in the same VM, G-5) uses http://127.0.0.1:7777.
ORCH_URL=https://orch.<domain>

# The token of the store API for a remote caller. Secret: keep it in 1Password.
# Preferred: a network secret of the environment, so the proxy adds the header X-Orch-Token for the ORCH_URL host and the session never sees it.
# Else set the value here in the environment settings, never in the repository.
ORCH_TOKEN=

# No app import and no desktop app in a VM.
ORCH_IMPORT=0

# .NET for the orch command. setup.sh installs .NET 10 in this folder.
DOTNET_ROOT=/root/.dotnet
DOTNET_CLI_TELEMETRY_OPTOUT=1

# Network: allow the host of ORCH_URL. The proxy refuses *.trycloudflare.com (G-0.1), so use the named tunnel of D2.
# Setup script of the environment, from the root of the repository:
#   bash session-orchestrator/src/Orchestrator.Providers/ClaudeCode/Cloud/setup.sh
