<article class="card default-review">
    <header class="card-head">
        <span class="pill by">@(Item.Answer.By == Parties.Docs ? "docs" : "default")</span>
        <span class="who">@Item.Title</span>
        @if (Item.Version is { Version: > 1 } v)
        {
            <span class="pill">v@(v.Version)</span>
        }
    </header>
    <h3>@Item.Decision.Question</h3>
    <p class="applied"><span class="label">Applied</span> @Item.Answer.Value <span class="reason">(@(Item.Answer.Reason ?? Item.Answer.Source ?? Item.Answer.By))</span></p>
    @if (Item.Version is { } version)
    {
        <p class="branch"><code>@version.Branch</code> on <code>@version.Base</code>
            @if (version.Url is { } url)
            {
                <a href="@url" target="_blank" rel="noopener">PR #@version.Pr</a>
            }
        </p>
    }
    <label class="answer-label" for="review-@Item.Decision.Id">Direction for change or refuse</label>
    <div class="speech-field">
        <textarea id="review-@Item.Decision.Id" class="answer" rows="2" placeholder="Optional for approve" @bind="text" @bind:event="oninput"></textarea>
        <Mic For="@($"review-{Item.Decision.Id}")" />
    </div>
    <div class="actions three">
        <button type="button" class="approve" @onclick='() => Submit("approve")'>Approve</button>
        <button type="button" class="secondary" disabled="@string.IsNullOrWhiteSpace(text)" @onclick='() => Submit("change")'>Change</button>
        <button type="button" class="refuse" disabled="@string.IsNullOrWhiteSpace(text)" @onclick='() => Submit("refuse")'>Refuse</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public DefaultToReview Item { get; set; } = default!;
    [Parameter] public EventCallback<(DefaultToReview, string, string)> OnReview { get; set; }

    string text = "";

    Task Submit(string verdict) => OnReview.InvokeAsync((Item, verdict, text.Trim()));
}
