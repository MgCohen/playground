<article class="card decision risk-@D.Risk" data-swipe-card>
    <header class="card-head">
        <span class="pill risk">@D.Risk</span>
        <span class="who">@Item.Title</span>
        <time>@Ago(D.Asked)</time>
    </header>
    <h3>@D.Question</h3>
    @if (!string.IsNullOrEmpty(D.Context))
    {
        <p class="context">@D.Context</p>
    }
    @if (!string.IsNullOrEmpty(D.Snippet))
    {
        <pre class="snippet">@D.Snippet</pre>
    }
    @if (!string.IsNullOrEmpty(D.Recommendation))
    {
        <p class="recommendation"><span class="label">Recommendation</span> @D.Recommendation</p>
    }
    @if (D.Options is { Length: > 0 } options)
    {
        <div class="options" role="group" aria-label="Suggestions">
            @foreach (var suggestion in options)
            {
                <button type="button" class="chip @(suggestion == D.DefaultOption ? "default" : "")" @onclick="() => text = suggestion">@suggestion</button>
            }
        </div>
    }
    <label class="answer-label" for="answer-@D.Id">Your answer, in free text</label>
    <textarea id="answer-@D.Id" class="answer" rows="2" placeholder="Type or dictate the answer" @bind="text" @bind:event="oninput" data-swipe-left></textarea>
    <div class="actions">
        <button type="button" class="primary" disabled="@string.IsNullOrWhiteSpace(text)" @onclick="Send">Send answer</button>
        @if (D.DefaultOption is { } option)
        {
            <button type="button" class="secondary" data-swipe-right @onclick="() => Submit(option)">Accept default: @option</button>
        }
    </div>
    <p class="hint">@Hint</p>
</article>

@code {
    [Parameter, EditorRequired] public OpenDecision Item { get; set; } = default!;
    [Parameter] public EventCallback<(OpenDecision, string)> OnAnswer { get; set; }

    string text = "";

    Decision D => Item.Decision;

    string Hint => D.DefaultOption is null
        ? "No default: the session waits for your answer."
        : "Swipe right to accept the default, left to write an answer.";

    Task Send() => Submit(text.Trim());

    Task Submit(string answer) => OnAnswer.InvokeAsync((Item, answer));

    public static string Ago(string at)
    {
        if (Orchestrator.Core.Leases.Times.Parse(at) is not { } time) return "";
        var age = DateTimeOffset.UtcNow - time;
        return age.TotalMinutes < 1 ? "now" : age.TotalHours < 1 ? $"{(int)age.TotalMinutes} min" : age.TotalDays < 1 ? $"{(int)age.TotalHours} h" : $"{(int)age.TotalDays} d";
    }
}
