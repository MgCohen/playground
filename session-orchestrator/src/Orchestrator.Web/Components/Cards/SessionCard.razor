<li class="node">
    <details class="card session state-@StateClass">
        <summary>
            <span class="dot" aria-hidden="true"></span>
            <span class="name">@(N.Meta.Title ?? N.Meta.Id[..8])</span>
            <span class="pill">@Label</span>
            @if (N.Open > 0)
            {
                <span class="pill wait">@N.Open open</span>
            }
        </summary>
        <dl class="facts">
            <dt>Id</dt><dd><code>@N.Meta.Id</code></dd>
            <dt>Folder</dt><dd><code>@N.Meta.Cwd</code></dd>
            @if (N.Meta.Branch is { } branch)
            {
                <dt>Worktree</dt><dd><code>@branch</code></dd>
            }
            <dt>Lease</dt><dd>@N.Holder@(N.Live ? " (live)" : "")</dd>
            @if (N.Update is { } u)
            {
                <dt>Update</dt><dd>@(u.Step is null ? "" : $"{u.Step}: ")@u.Summary@(u.Progress is { } p ? $" ({p} %)" : "")</dd>
            }
            @if (N.Report is { } r)
            {
                <dt>Report</dt><dd><span class="pill report-@r.State">@r.State</span> @r.Summary</dd>
            }
            @if (N.Blocked is { } b)
            {
                <dt>Blocked</dt><dd class="warn">@b</dd>
            }
        </dl>
        <label class="answer-label" for="send-@N.Meta.Id">Message to this session</label>
        <textarea id="send-@N.Meta.Id" class="answer" rows="2" @bind="text" @bind:event="oninput"></textarea>
        <div class="actions">
            <button type="button" class="primary" disabled="@string.IsNullOrWhiteSpace(text)" @onclick="Send">Send</button>
            @if (N.Control == ControlStates.Active)
            {
                <button type="button" class="secondary" @onclick="() => OnStop.InvokeAsync(N)">Stop</button>
            }
            else if (N.Control == ControlStates.Stopped)
            {
                <button type="button" class="secondary" @onclick="() => OnResume.InvokeAsync(N)">Resume</button>
            }
            @if (N.Control != ControlStates.Archived)
            {
                <button type="button" class="refuse" @onclick="() => OnArchive.InvokeAsync((N, false))">Archive</button>
            }
        </div>
    </details>
    @if (N.Children.Count > 0)
    {
        <ul class="tree">
            @foreach (var child in N.Children)
            {
                <SessionCard @key="child.Meta.Id" Node="child" OnStop="OnStop" OnResume="OnResume" OnArchive="OnArchive" OnSend="OnSend" />
            }
        </ul>
    }
</li>

@code {
    [Parameter, EditorRequired] public SessionNode Node { get; set; } = default!;
    [Parameter] public EventCallback<SessionNode> OnStop { get; set; }
    [Parameter] public EventCallback<SessionNode> OnResume { get; set; }
    [Parameter] public EventCallback<(SessionNode, bool)> OnArchive { get; set; }
    [Parameter] public EventCallback<(SessionNode, string)> OnSend { get; set; }

    string text = "";

    SessionNode N => Node;

    string StateClass => N.Control != ControlStates.Active ? N.Control : N.Blocked is not null ? "blocked" : N.Open > 0 ? "waits" : N.Running || N.State == "running" ? "running" : N.Report?.State == ReportStates.Done ? "done" : "idle";

    string Label => StateClass switch
    {
        "waits" => "waits for you",
        _ => StateClass,
    };

    async Task Send()
    {
        await OnSend.InvokeAsync((N, text.Trim()));
        text = "";
    }
}
