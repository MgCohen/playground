@inject Board Board

<li class="event kind-@Css">
    <details open="@open">
        <summary @onclick="() => open = !open" @onclick:preventDefault>
            <time datetime="@Event.At">@Time</time>
            <span class="pill">@Event.Kind</span>
            <span class="route">@Board.Party(Event.From) → @Board.Party(Event.To)</span>
            <span class="subject">@Event.Subject</span>
        </summary>
        @if (open)
        {
            var fields = Fields();
            switch (Event.Kind)
            {
                case EventKinds.Decision or EventKinds.Query: <DecisionFields Fields="fields" /> break;
                case EventKinds.Answer: <AnswerFields Fields="fields" /> break;
                case EventKinds.Review: <ReviewFields Fields="fields" /> break;
                case EventKinds.Report: <ReportFields Fields="fields" /> break;
                case EventKinds.Update: <UpdateFields Fields="fields" /> break;
                case EventKinds.Brief: <BriefFields Fields="fields" /> break;
                default: <pre class="body">@Board.BodyText(Event)</pre> break;
            }
        }
    </details>
</li>

@code {
    [Parameter, EditorRequired] public Event Event { get; set; } = default!;

    bool open;

    string Css => Event.Kind.Replace('.', '-');

    string Time => Orchestrator.Core.Leases.Times.Parse(Event.At)?.ToLocalTime().ToString("HH:mm:ss") ?? Event.At;

    IReadOnlyDictionary<string, object?> Fields() =>
        Board.BodyText(Event) is { } text ? Orchestrator.Core.Templates.Render.Fields(JsonSerializer.Deserialize<JsonElement>(text)) : new Dictionary<string, object?>();
}
