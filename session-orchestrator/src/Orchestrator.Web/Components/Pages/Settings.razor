@page "/settings"
@inherits LiveView
@inject IJSRuntime JS

<PageTitle>Settings · orch</PageTitle>

<PageHeader Title="Settings" />

<div class="stack">
    <h2 class="gt">Store</h2>
    <div class="crd">
        <div class="kv"><span class="k">Folder</span><span class="mono ell">@root</span></div>
        <div class="kv"><span class="k">Sessions</span><span class="mono">@sessions</span></div>
    </div>
    <h2 class="gt">Display</h2>
    <div class="crd">
        <div class="kv"><span class="k">Theme</span><span>Follows the device: light or dark</span></div>
        <div class="kv"><span class="k">Undo time</span><span class="mono">@(undo is { } u ? $"{u.TotalSeconds:0.#} s" : "")</span></div>
    </div>
    <div class="empty"><span class="nm">More settings come later</span><span class="sub">For example a form for each message type.</span></div>
</div>

@code {
    string root = "";
    int sessions;

    // The undo time is the token --t-undo of motion.css (I11), so it shows after the first render.
    TimeSpan? undo;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        undo = await MotionTimes.Of(JS, "--t-undo");
        StateHasChanged();
    }

    protected override void Load()
    {
        root = Board.StoreRoot;
        sessions = Ui.Flatten(Board.Tree()).Count();
    }
}
