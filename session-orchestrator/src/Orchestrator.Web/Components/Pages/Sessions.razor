@page "/sessions"
@inherits LiveView

<PageTitle>Sessions · orch</PageTitle>

<header class="crd hd"><h1 class="title disp">Sessions</h1></header>

<div class="stack">
    @if (Message is not null)
    {
        <p class="toast inline" role="status">@Message</p>
    }
    <label class="well row search">
        <Icon Name="search" />
        <span class="sr">Search sessions</span>
        <input id="session-search" type="search" placeholder="Search sessions" @bind="search" @bind:event="oninput" />
    </label>
    @if (tree.Count == 0)
    {
        <div class="empty"><span class="nm">No sessions</span><span class="sub">Start one with the form below or with <code>orch new</code>.</span></div>
    }
    @{ var firstFold = Shown.FirstOrDefault(n => n.Children.Count > 0)?.Meta.Id; }
    @foreach (var node in Shown)
    {
        <SessionTree @key="node.Meta.Id" Node="node" Open="@(node.Meta.Id == firstFold || search.Length > 0)" />
    }
    <NewSessionForm Parents="parents" OnStart="Start" Open="tree.Count == 0" />
</div>

@code {
    IReadOnlyList<SessionNode> tree = [];
    IReadOnlyList<ParentOption> parents = [];
    string search = "";

    IEnumerable<SessionNode> Shown => search.Trim() is { Length: > 0 } text
        ? tree.Where(r => Ui.Flatten([r]).Any(n => Ui.Name(n).Contains(text, StringComparison.OrdinalIgnoreCase)))
        : tree.Where(r => r.Control != ControlStates.Archived);

    protected override void Load()
    {
        tree = Board.Tree();
        parents = Ui.Flatten(tree).Where(n => n.Control != ControlStates.Archived).Select(n => new ParentOption(n.Meta.Id, Ui.Name(n), n.Meta.Cwd)).ToList();
    }

    bool Start(NewSession input)
    {
        var started = Act(() => Board.NewSession(input), $"Started {input.Title}.");
        StateHasChanged();
        return started;
    }
}
