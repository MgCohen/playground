@page "/timeline"
@inherits LiveView

<PageTitle>Timeline · orch</PageTitle>

<section class="view" aria-labelledby="timeline-title">
    <h1 id="timeline-title">Timeline <span class="count">@events.Count</span></h1>
    <form class="filters" @onsubmit="Load" @onsubmit:preventDefault>
        <label for="since">Since</label>
        <select id="since" @bind="since" @bind:after="Load">
            <option value="1h">1 hour</option>
            <option value="3h">3 hours</option>
            <option value="1d">1 day</option>
            <option value="7d">7 days</option>
            <option value="">All</option>
        </select>
        <label for="kind">Kinds</label>
        <select id="kind" @bind="group" @bind:after="Load">
            <option value="">All</option>
            <option value="messages">Messages only</option>
            <option value="needs">Needs the user</option>
            <option value="git">Git</option>
        </select>
        <label for="session">Session</label>
        <input id="session" placeholder="id or empty" @bind="session" @bind:event="onchange" @bind:after="Load" />
        <label class="check"><input id="tools" type="checkbox" @bind="tools" @bind:after="Load" /> Tool calls</label>
    </form>
    @if (events.Count == 0)
    {
        <p class="empty">No events match the filters.</p>
    }
    <ol class="timeline">
        @foreach (var e in events)
        {
            <EventCard @key="e.Id" Event="e" />
        }
    </ol>
</section>

@code {
    static readonly Dictionary<string, string[]> Groups = new()
    {
        ["messages"] = [EventKinds.Decision, EventKinds.Answer, EventKinds.Review, EventKinds.Report, EventKinds.Update, EventKinds.Brief, EventKinds.Notice, EventKinds.Message, EventKinds.Query, EventKinds.Plan, EventKinds.Ack],
        ["needs"] = [EventKinds.Decision, EventKinds.Query, EventKinds.Plan, EventKinds.Report, EventKinds.Blocked, EventKinds.DeliveryBlocked],
        ["git"] = [EventKinds.BranchCreate, EventKinds.BranchRebase, EventKinds.PrOpen, EventKinds.PrReady, EventKinds.PrClose],
    };

    IReadOnlyList<Event> events = [];
    string since = "3h";
    string group = "";
    string session = "";
    bool tools;

    protected override void Load()
    {
        var filter = new StreamQuery
        {
            Since = since.Length > 0 ? Durations.Since(since, DateTimeOffset.UtcNow) : null,
            Kinds = Groups.TryGetValue(group, out var kinds) ? kinds.ToHashSet() : null,
            Session = session.Trim(),
        };
        events = Board.Timeline(filter).Where(e => tools || e.Kind != EventKinds.SessionTool).ToList();
    }
}
