@page "/"
@inherits LiveView

<PageTitle>Queue · orch</PageTitle>

<section class="view" aria-labelledby="open-title">
    <h1 id="open-title">Waits for you <span class="count">@open.Count</span></h1>
    @if (Message is not null)
    {
        <p class="toast" role="status">@Message</p>
    }
    @if (open.Count == 0)
    {
        <p class="empty">No open decisions. A new question from a session shows here.</p>
    }
    @foreach (var item in open)
    {
        <DecisionCard @key="item.Decision.Id" Item="item" OnAnswer="Answer" />
    }
</section>

<section class="view" aria-labelledby="defaults-title">
    <h2 id="defaults-title">Defaults to review <span class="count">@defaults.Count</span></h2>
    @if (defaults.Count == 0)
    {
        <p class="empty">No default decisions to review.</p>
    }
    @foreach (var item in defaults)
    {
        <DefaultCard @key="item.Decision.Id" Item="item" OnReview="Review" />
    }
</section>

@code {
    IReadOnlyList<OpenDecision> open = [];
    IReadOnlyList<DefaultToReview> defaults = [];

    protected override void Load()
    {
        open = Board.OpenDecisions();
        defaults = Board.DefaultsToReview();
    }

    void Answer((OpenDecision Item, string Text) a) =>
        Act(() => Board.Answer(a.Item.Session, a.Item.Decision.Id, a.Text), $"Answer sent to {a.Item.Title}.");

    void Review((DefaultToReview Item, string Verdict, string Text) r) =>
        Act(() => Board.Review(r.Item.Session, r.Item.Decision.Id, r.Verdict, r.Text), $"Review {r.Verdict} sent to {r.Item.Title}.");
}
