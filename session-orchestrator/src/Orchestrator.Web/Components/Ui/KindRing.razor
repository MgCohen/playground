@inject Board Board
@{ var (icon, color) = Board.Look(Kind, State); }
<Ring Key="@Key" P="P" Size="Size" Th="@Math.Max(3, Size / 7)" Color="@($"var(--{color})")"><Icon Name="@icon" /></Ring>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter] public string? State { get; set; }
    [Parameter] public double P { get; set; } = 1;
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string? Key { get; set; }
}
