@* One row of the stream: the preview of the envelope, from the view.json of its kind. *@
@inject Board Board
@{ var f = Board.Fields(Event); var state = Ui.Text(f.GetValueOrDefault("state")); var open = Board.IsOpen(Event); var p = Board.Preview(Event); }
<div class="tli" data-kind="@Event.Kind">
    <span class="node"><KindRing Key="@($"e:{Event.Id}")" Kind="@Event.Kind" State="@state" P="@(open ? .5 : 1)" Size="30" /></span>
    <a class="crd row ev" href="events/@Event.Id">
        <span class="grow">
            <span class="l1"><b class="grow ell">@Ui.KindLabel(Event.Kind, f) · @Route</b><span class="mono sub">@Ui.Clock(Ui.Time(Event))</span></span>
            <span class="t2 ell">@p.Title</span>
            @if (p.Line is { Length: > 0 } line)
            {
                <span class="sub ell line">@line</span>
            }
            <span class="l3">
                <Pill Label="@Status(open, state)" State="@Color(open, state)" />
                @if (p.Pill is { } pill && pill.Text != Status(open, state))
                {
                    <FactValue Fact="pill" />
                }
                @if (p.Progress is { } progress)
                {
                    <Progress Value="progress" />
                }
            </span>
        </span>
    </a>
</div>

@code {
    [Parameter, EditorRequired] public Event Event { get; set; } = default!;

    string Route => Event.From == Parties.User ? $"you → {Board.Party(Event.To)}" : Event.To == Parties.User ? Board.Party(Event.From) : $"{Board.Party(Event.From)} → {Board.Party(Event.To)}";

    string Status(bool open, string state) => open ? "waits" : Event.Kind switch
    {
        EventKinds.Report => state is { Length: > 0 } ? state : "report",
        EventKinds.Question => "answered",
        EventKinds.Ack => "ack",
        _ when EventKinds.Messages.Contains(Event.Kind) && Event.To.StartsWith(Parties.SessionPrefix) => Board.IsAcked(Event) ? "delivered" : "sent",
        _ => Event.Kind,
    };

    static string Color(bool open, string state) => open ? "pending" : state == "blocked" ? "failed" : "done";
}
