@* The facts and the blocks of a full document, in the order of the view.json of its kind. *@
@using Orchestrator.Core.Templates
@using Orchestrator.Web.Components.Ui.Looks
@if (Doc.Facts.Count > 0)
{
    <div class="crd facts">
        @foreach (var fact in Doc.Facts)
        {
            <div class="kv" data-field="@fact.Field"><span class="k">@fact.Label</span><FactValue Fact="fact" /></div>
        }
    </div>
}
@foreach (var block in Doc.Blocks)
{
    <h2 class="gt">@block.Label</h2>
    <div class="crd pad doc blk @block.As" data-field="@block.Field" style="@(block.Tone is { } t ? $"--st:var(--{t})" : null)">
        <DynamicComponent Type="LookComponents.Of(block.As)" Parameters="LookComponents.Parameters(LookValue.Of(block))" />
    </div>
}

@code {
    [Parameter, EditorRequired] public DocumentModel Doc { get; set; } = default!;
}
