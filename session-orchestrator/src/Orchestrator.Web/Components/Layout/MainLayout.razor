@* The app frame: the page, the app bar and the motion host. A tab change (T1, option C) puts is-tab-in on the page in the same
   render as the new page, so its blocks rise one after the other from their first frame (motion.css); the header and the app
   bar stay. The class goes when the motion ends. A push and a back are view transitions (MotionHost). *@
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ICommandSender Commands

<div class="app">
    <main class="page @(tabIn ? "is-tab-in" : "")" data-motion="tab-in" @ref="page">
        @Body
    </main>
    <AppBar />
</div>
<MotionHost />

@code {
    ElementReference page;
    string? last;
    bool tabIn, settle;

    protected override void OnParametersSet()
    {
        var here = Nav.ToBaseRelativePath(Nav.Uri);
        if (last is not null && PageDepth.Move(last, here) == PageDepth.Tab)
        {
            tabIn = true;
            settle = true;
        }
        last = here;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!settle) return;
        settle = false;
        // The key makes a newer tab change cancel this wait: the later change keeps the class for its own blocks.
        var waited = await Commands.SendAsync(new MotionWait(page, WaitMode.Step) { Key = MotionSteps.TabIn.Name }, default);
        if (waited.Error?.Code == Orchestrator.Web.Plugins.Js.Contracts.JsErrors.Canceled) return;
        tabIn = false;
        StateHasChanged();
    }
}
