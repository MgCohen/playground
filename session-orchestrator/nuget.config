<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Umpire packages come from GitHub Packages. The token is the environment variable GITHUB_TOKEN (gh auth token). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="umpire" value="https://nuget.pkg.github.com/MgCohen/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="umpire">
      <package pattern="Umpire" />
      <package pattern="Umpire.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <umpire>
      <add key="Username" value="MgCohen" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </umpire>
  </packageSourceCredentials>
</configuration>
